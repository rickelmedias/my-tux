# =============================================================================
# Configurações do Bootstrap
# Copie este arquivo para .env e preencha com suas informações
# =============================================================================

# ── Git & GitHub ──────────────────────────────────────────────────────────────
GIT_USER_NAME="Seu Nome"
GIT_USER_EMAIL="seu.email@exemplo.com"

# ── Python (Conda/PyTorch) ────────────────────────────────────────────────────
# Versões do Python para criar ambientes conda
# Opções: 3.10, 3.11, ou "both" para ambos
PYTHON_VERSIONS="3.10"  # 3.10 | 3.11 | both

# Opcional: forçar o ambiente alvo manualmente
# BOOTSTRAP_TARGET="wsl"                 # wsl | operational-system

# ── Neovim ────────────────────────────────────────────────────────────────────
# Instalar versão unstable do Neovim? (necessário para alguns plugins)
INSTALL_NVIM_UNSTABLE="true"  # true | false
